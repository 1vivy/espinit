type esu_blk_device dev_type
type esu_bootctl domain
typeattribute esu_bootctl hal_bootctl_server
allow init esu_bootctl process transition
allow init esu_bootctl process2 nosuid_transition
allow init esu_bootctl process { rlimitinh siginh }
dontaudit init esu_bootctl process noatsecure
allow esu_bootctl esu_bootctl process getsched
allow esu_bootctl esu_bootctl dir search
allow esu_bootctl esu_bootctl file { getattr open read }
allow esu_bootctl esu_bootctl lnk_file read
allow esu_bootctl esu_bootctl unix_dgram_socket { create connect write }
allow esu_bootctl binder_device chr_file { open read write ioctl map }
allowxperm esu_bootctl binder_device chr_file ioctl 0x6200-0x62ff
allow esu_bootctl servicemanager_prop file { getattr map open read }
allow esu_bootctl block_device dir search
allow esu_bootctl misc_block_device blk_file { getattr open read write }
allow esu_bootctl hal_bootctl_service service_manager { add find }
allow esu_bootctl hal_bootctl_hwservice hwservice_manager { add find }

# --- OTA transaction (esu/modules/boot-hal/layer/src/txn.rs) ---
#
# Every rule below is written against the platform type names the code opens and
# is UNVERIFIED on a device: the plan harvests the real set from a permissive
# boot before this module is deployed enforcing (see README, "OTA transaction").
#
# The esd device-name tree: the staging logical volumes, the physical partitions
# the projection hides and the device-mapper control node esud publishes there.
# Each consumer declares `esu_blk_device` before its own rules because module
# policies are applied individually in modules_order. Type creation is
# idempotent. Comments must not contain semicolons.
allow esu_bootctl esu_blk_device dir search
allow esu_bootctl esu_blk_device blk_file { getattr open read write }
allow esu_bootctl esu_blk_device chr_file { getattr open read write ioctl }
# The ESP: the staged takeover archive, the promoted base images and the denial
# receipt are written inside a read-write window on the read-only mount.
allow esu_bootctl vfat dir { getattr open read search write add_name remove_name }
allow esu_bootctl vfat file { getattr open read write create rename unlink setattr }
allow esu_bootctl vfat filesystem remount
allow esu_bootctl vfat dir mounton
allow esu_bootctl esu_bootctl capability sys_admin
# The switch devices are reloaded through device-mapper, and the promoted image
# keeps serving the running letter through a read-only loop device.
allow esu_bootctl dm_device chr_file { getattr open read write ioctl }
allow esu_bootctl loop_control_device chr_file { getattr open read write ioctl }
allow esu_bootctl loop_device blk_file { getattr open read write }
# Resolving a device-mapper name scans the block class and reads `dm/name`,
# `dev` and `size`.
allow esu_bootctl sysfs_type dir { open read search }
allow esu_bootctl sysfs_type file { getattr open read }
# The static `lvm` and `esud` the staging set is created and removed with run
# from the payload tmpfs label.
allow esu_bootctl esu_file file { getattr open read execute execute_no_trans }
# Spawning them (and `cmd` below) forks in this domain and reads the child's
# output and exec-status pipes. Observed denied enforcing on the phone and
# logged on every spawn by the permissive Cuttlefish proof.
allow esu_bootctl esu_bootctl process fork
allow esu_bootctl esu_bootctl fifo_file { getattr read write }
# The denial notification: `/system/bin/cmd notification post` talks to
# system_server.
allow esu_bootctl system_file file { getattr open read execute execute_no_trans }
allow esu_bootctl system_server binder { call transfer }
allow esu_bootctl system_server_service service_manager find
deny hal_bootctl_server hal_bootctl_service service_manager add
deny hal_bootctl_server hal_bootctl_hwservice hwservice_manager add
deny hal_bootctl_default hal_bootctl_service service_manager add
deny hal_bootctl_default hal_bootctl_hwservice hwservice_manager add
dontaudit hal_bootctl_default hal_bootctl_service service_manager add
dontaudit hal_bootctl_default hal_bootctl_hwservice hwservice_manager add
dontaudit mediaserver esu_bootctl dir search
