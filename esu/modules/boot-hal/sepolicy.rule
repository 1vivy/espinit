type esu_bootctl domain
typeattribute esu_bootctl hal_bootctl_server
permissive esu_bootctl
allow init esu_bootctl process transition
allow init esu_bootctl process2 nosuid_transition
allow esu_bootctl hal_bootctl_service service_manager { add find }
allow esu_bootctl hal_bootctl_hwservice hwservice_manager { add find }
deny hal_bootctl_server hal_bootctl_service service_manager add
deny hal_bootctl_server hal_bootctl_hwservice hwservice_manager add
deny hal_bootctl_default hal_bootctl_service service_manager add
deny hal_bootctl_default hal_bootctl_hwservice hwservice_manager add
dontaudit hal_bootctl_default hal_bootctl_service service_manager add
dontaudit hal_bootctl_default hal_bootctl_hwservice hwservice_manager add
