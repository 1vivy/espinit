# The SELinux type esud labels every node under /dev/block/esd with
# (u:object_r:esu_blk_device:s0). Each consumer declares it before its own rules
# because module policies are applied individually in modules_order.
# Type creation is idempotent. Comments must not contain semicolons.
type esu_blk_device dev_type

# esud runs in the `esu` domain and owns the tree: it creates the directories
# and the block/char nodes, labels them and removes the nodes whose device
# disappeared on a refresh.
allow esu esu_blk_device dir { add_name create getattr open read remove_name search setattr write }
allow esu esu_blk_device blk_file { create getattr open read relabelfrom relabelto setattr unlink write }
allow esu esu_blk_device chr_file { create getattr open read relabelfrom relabelto setattr unlink write }
allow esu esu capability mknod
