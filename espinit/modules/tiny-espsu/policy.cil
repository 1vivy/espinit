; Documentation/package mirror only. kernel/selinux/rules.c applies these rules
; at init second_stage, before on-init and early_hal. Not a late policy loader.
; No file_type/dev_type attributes: do not inherit broad stock grants.
(type gblbds_hal_exec)
(type gblbds_bdsvars_block_device)
(roletype object_r gblbds_hal_exec)
(roletype object_r gblbds_bdsvars_block_device)
(allow hal_bootctl_default gblbds_bdsvars_block_device (blk_file (getattr open read write ioctl lock)))
(allow init gblbds_hal_exec (file (getattr open read execute map)))
(allow hal_bootctl_default gblbds_hal_exec (file (getattr open read execute map entrypoint)))
(typetransition init gblbds_hal_exec process hal_bootctl_default)
(allow gblbds_hal_exec labeledfs (filesystem (associate)))
(allow gblbds_bdsvars_block_device tmpfs (filesystem (associate)))
(allow init hal_bootctl_default (process2 (nosuid_transition)))
; The HAL reads the staged /metadata/espinit/rom.toml before registering.
(allow hal_bootctl_default metadata_file (dir (search)))
(allow hal_bootctl_default metadata_file (file (getattr open read)))
; lock is necessary for the HAL's preserved flock transaction; absent in source CIL.
; Other init -> hal_bootctl_default process/FD/signal and misc access stay stock.
