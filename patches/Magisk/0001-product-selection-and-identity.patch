+}
+
+pub(crate) fn daemon_setup_logging() {
+    // The early daemon precedes logd and its own FIFO reader. Keep startup
+    // errors visible even after its standard descriptors are detached.
+    fn setup_write(level: LogLevel, msg: &Utf8CStr) {
+        android_log_write(level, msg);
+        if matches!(level, LogLevel::Warn | LogLevel::Error)
+            && let Ok(mut kernel) = fs::OpenOptions::new().write(true).open("/dev/kmsg")
+        {
+            kernel.write_all(msg.as_bytes()).ok();
+        }
+    }
+    update_logger(|logger| logger.write = setup_write);
 }
 
