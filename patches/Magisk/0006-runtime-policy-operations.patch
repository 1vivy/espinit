             allow([proc], ["system_file", "vendor_file"], ["lnk_file"], ["create", "setattr", "unlink", "rename"]);
             allow([proc], ["file_type"], ["lnk_file"], ["read", "getattr", "relabelto", "relabelfrom"]);
