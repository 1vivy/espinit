             allow([proc], [proc], ["unix_dgram_socket"], ["create", "connect", "read", "write", "getattr", "setopt", "getopt"]);
@@ -76,11 +84,18 @@
             allow([proc], ["file_type"], ["dir"], ["open", "read", "search", "getattr", "mounton"]);
