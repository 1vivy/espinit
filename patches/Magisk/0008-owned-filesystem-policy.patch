diff --git a/native/src/sepolicy/rules.rs b/native/src/sepolicy/rules.rs
--- a/native/src/sepolicy/rules.rs
+++ b/native/src/sepolicy/rules.rs
@@ -58,6 +58,8 @@
             allow(["init"], [proc], ["process"], ["transition", "dyntransition", "sigchld", "getattr", "noatsecure", "rlimitinh", "siginh"]);
             allow(["init"], [proc], ["process2"], ["nosuid_transition"]);
             allow(["init"], [file], ["dir"], ["search", "open", "read", "getattr", "write", "add_name", "create", "setattr"]);
             allow(["init"], [file], ["file"], ["open", "read", "execute", "execute_no_trans", "entrypoint", "map", "getattr", "relabelto"]);
