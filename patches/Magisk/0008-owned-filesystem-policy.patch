+            allow(["init"], [file], ["chr_file"], ["getattr", "relabelfrom", "relabelto"]);
             allow(["init"], [proc], ["unix_stream_socket"], ["connectto"]);
             allow(["init"], [file], ["sock_file"], ["open", "read", "write", "getattr"]);
@@ -76,8 +78,10 @@
-            allow([proc], [file], ["dir"], ["create", "open", "read", "write", "search", "add_name", "remove_name", "getattr", "setattr", "rmdir", "rename", "mounton", "relabelto", "relabelfrom"]);
+            allow([proc], [file], ["dir"], ["create", "open", "read", "write", "search", "add_name", "remove_name", "getattr", "setattr", "rmdir", "rename", "reparent", "mounton", "relabelto", "relabelfrom"]);
             allow([proc], [file], ["file"], ["create", "open", "read", "write", "append", "map", "execute", "execute_no_trans", "entrypoint", "getattr", "setattr", "unlink", "rename", "link", "ioctl", "lock", "relabelto", "relabelfrom"]);
             allow([proc], [file], ["fifo_file"], ["create", "open", "read", "write", "getattr", "setattr", "relabelto", "relabelfrom"]);
             allow([proc], [file], ["lnk_file"], ["create", "read", "getattr", "setattr", "unlink", "rename", "relabelto", "relabelfrom"]);
             allow([proc], [file], ["sock_file"], ["create", "open", "read", "write", "getattr", "setattr", "unlink", "relabelto", "relabelfrom"]);
+            // OverlayFS creates, links and removes 0:0 character-device whiteouts.
+            allow([proc], [file], ["chr_file"], ["create", "getattr", "setattr", "unlink", "rename", "link", "relabelfrom", "relabelto"]);
             allow([proc], [log], ["fifo_file"], ["create", "open", "read", "write", "getattr", "setattr", "unlink", "relabelto", "relabelfrom"]);
             // Projection must read target attributes and bind module exports at
             // their original Android contexts, without making those domains esp.
@@ -100,6 +104,14 @@
             allow([proc], ["tmpfs"], ["file"], ["create", "open", "read", "write", "getattr", "setattr", "mounton", "relabelto", "relabelfrom"]);
             allow([proc], ["tmpfs"], ["lnk_file"], ["create", "read", "getattr", "setattr", "relabelto", "relabelfrom"]);
             allow([proc], ["fs_type"], ["filesystem"], ["mount", "remount", "unmount", "getattr"]);
             allow([proc], ["rootfs", "tmpfs"], ["filesystem"], ["associate"]);
