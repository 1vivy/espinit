+            allow([proc], [file], ["filesystem"], ["mount", "unmount", "getattr", "relabelto"]);
+            allow([file], [file], ["filesystem"], ["associate"]);
             allow([proc], ["proc"], ["dir"], ["search", "open", "read", "getattr"]);
             allow([proc], ["proc"], ["file"], ["open", "read", "getattr"]);
+            // Native detaches from the blocking init client's cgroup before exit.
+            allow([proc], ["cgroup", "cgroup_v2"], ["dir"], ["search", "getattr"]);
+            allow([proc], ["cgroup", "cgroup_v2"], ["file"], ["open", "write", "append", "getattr"]);
