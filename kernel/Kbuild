kernelsu-esp-objs := core/init.o
kernelsu-esp-objs += hook/syscall_event_bridge.o
kernelsu-esp-objs += hook/syscall_hook_manager.o
kernelsu-esp-objs += hook/syscall_hook.o
ifeq ($(CONFIG_ARM64),y)
kernelsu-esp-objs += hook/arm64/patch_memory.o
kernelsu-esp-objs += hook/arm64/syscall_hook.o
else ifeq ($(CONFIG_X86_64),y)
kernelsu-esp-objs += hook/x86_64/patch_memory.o
kernelsu-esp-objs += hook/x86_64/syscall_hook.o
else ifeq ($(CONFIG_RISCV),y)
kernelsu-esp-objs += hook/riscv64/patch_memory.o
kernelsu-esp-objs += hook/riscv64/syscall_hook.o
endif

kernelsu-esp-objs += infra/symbol_resolver.o
kernelsu-esp-objs += runtime/esud_integration.o
kernelsu-esp-objs += selinux/selinux.o
kernelsu-esp-objs += selinux/rules.o
kernelsu-esp-objs += selinux/sepolicy.o
kernelsu-esp-objs += supercall/dispatch.o
kernelsu-esp-objs += supercall/perm.o
kernelsu-esp-objs += supercall/supercall.o

ifdef KBUILD_EXTMOD
ifeq ($(CONFIG_KERNELESP_DEBUG),y)
ccflags-y += -DCONFIG_KERNELESP_DEBUG=1
endif
# Supported external x86 ACK/DDK lanes use the hardened dispatcher adaptation.
# The generic module builder need not know this helper's Kconfig symbols.
# Explicit n remains available for a kernel with the source-side bypass patch.
ifeq ($(CONFIG_X86_64),y)
ifneq ($(CONFIG_KERNELESP_X86_PATCH_SYSCALL_DISPATCHER),n)
ccflags-y += -DCONFIG_KERNELESP_X86_PATCH_SYSCALL_DISPATCHER=1
endif
endif
endif # KBUILD_EXTMOD

ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
ccflags-y += -I$(objtree)/security/selinux -include $(srctree)/include/uapi/asm-generic/errno.h

ifneq ($(KBUILD_EXTMOD),)
# 6.18 exports the external module source as srcroot when M/MO are used.
ifneq ($(srcroot),)
KSU_KERNEL_DIR := $(srcroot)
endif
endif
ifndef KSU_KERNEL_DIR
ifeq ($(filter /%,$(src)),)
KSU_KERNEL_DIR := $(srctree)/$(src)
else
KSU_KERNEL_DIR := $(src)
endif
endif

ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include

ifdef KBUILD_EXTMOD
obj-m += kernelsu-esp.o
else
obj-$(CONFIG_KERNELESP) += kernelsu-esp.o
endif

MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# Workaround bazel
# https://github.com/tiann/KernelSU/pull/316#issuecomment-1479043219
GIT := $(shell PATH="$$PATH":/usr/bin:/usr/local/bin which git)
ifneq ($(GIT),)
# Check if this is a git repository
# Try to detect Git repo intelligently
GIT_ROOT := $(shell cd $(MDIR) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),)
KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
# Only set version if it's a different repo from kernel
$(shell cd $(GIT_ROOT) && [ -f .git/shallow ] && $(GIT) fetch --unshallow 2>/dev/null || true)
KSU_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(GIT) rev-list --count HEAD 2>/dev/null)
KSU_GIT_VERSION_VALID := 1
$(info -- esu: Git repo detected at $(GIT_ROOT))
endif
endif
else
$(warning -- esu: Git not detected, make sure git is installed in your PATH!)
endif


# Calculate version if git version is available
ifdef KSU_GIT_VERSION_VALID
# ksu_version: major * 10000 + git version + 200 for historical reasons
$(eval KSU_VERSION=$(shell expr 30000 + $(KSU_GIT_VERSION)))
$(info -- esu version: $(KSU_VERSION))
ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
else
# If there is no .git directory, use default version
$(warning "KSU_GIT_VERSION not defined! It is better to make esu a git repository!")
ccflags-y += -DKSU_VERSION=16
endif

KSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- KSU_NEW_DCACHE_FLUSH: $(KSU_NEW_DCACHE_FLUSH))



ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function

# Keep a new line here!! Because someone may append config
